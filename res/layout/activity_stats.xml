<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:background="@drawable/header_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="使用统计"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_main" />

        <Button
            android:id="@+id/btnStatsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/circle_bg"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">

            <!-- 汇总卡：收入 / 支出 / 净变化 / 笔数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="▥"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/tvStatsCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="交通卡"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_main"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvStatsRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_sub"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第一行：收入 / 支出 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/tile_bg"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="收入（充值）"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_sub" />

                        <TextView
                            android:id="@+id/tvStatsIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/gain"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/tile_bg"
                        android:padding="14dp"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="支出（消费）"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_sub" />

                        <TextView
                            android:id="@+id/tvStatsOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_main"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第二行：净变化 / 笔数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/tile_bg"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="净变化（收入−支出）"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_sub" />

                        <TextView
                            android:id="@+id/tvStatsNet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_main"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/tile_bg"
                        android:padding="14dp"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="交易笔数"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_sub" />

                        <TextView
                            android:id="@+id/tvStatsCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/text_main"
                            android:layout_marginTop="3dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 单笔金额柱状图（横轴=笔序，不用时间） -->
            <LinearLayout
                android:id="@+id/barStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="▮"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="单笔金额"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="绿 充值 · 灰 消费"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <com.cubalance.app.BarChart
                    android:id="@+id/barStats"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tile_bg" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="横轴为交易笔序（旧 → 新，不使用时间）；点任意一根柱子会亮起光柱并显示这一笔的金额。"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- 收支明细（记账） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="≡"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="收支明细"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/tvStatsMix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="卡内没有读到交易记录。贴卡读取一次后再来看。"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/txnList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="数据来自卡内最近约 20 笔交易记录，只读、不联网、只存本机。想看某一次读卡当时的明细，可在「卡片 → 详情 → 余额记录」里点那一条。"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_sub"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
