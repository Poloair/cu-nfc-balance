<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:background="@drawable/header_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="卡片详情"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_main" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/circle_bg"
            android:textColor="@color/up" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="72dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="返回"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text_main"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- 余额主卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/balance_bg"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ₩"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/detailSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 卡片管理：备注 / 可用天数提醒 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="✎"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="卡片管理"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- 备注 -->
                <LinearLayout
                    android:id="@+id/rowAlias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="备注"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/tvAlias"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="未设置"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 可用天数提醒（按最近消费估算） -->
                <LinearLayout
                    android:id="@+id/rowAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="可用天数提醒"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/tvAlert"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="关闭"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- 余额走势卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="∿"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="余额走势"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <com.cubalance.app.BalanceChart
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tile_bg" />
            </LinearLayout>

            <!-- 余额记录卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="≡"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/history"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHistHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点任意一条，可看当次读卡读到的交易明细"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="4dp" />

                <ListView
                    android:id="@+id/lvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:layout_marginTop="8dp" />

                <!-- 记录多了折叠：默认只摆最近 5 次，展开后在固定高度里滚动 -->
                <TextView
                    android:id="@+id/btnHistMore"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="展开全部"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textColor="@color/brand"
                    android:background="@drawable/tile_click"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
