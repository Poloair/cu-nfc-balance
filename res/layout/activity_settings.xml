<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="104dp">

            <!-- 顶栏：大标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_main" />
            </LinearLayout>

            <!-- 数据状态卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="▤"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/brand"
                        android:background="@drawable/icon_sq" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本机数据"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCardCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="还没有保存的卡片"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- 通用设置卡：NFC 状态 / 支持的卡种 / 隐私说明 / 清空全部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="10dp"
                android:layout_marginTop="14dp">

                <!-- NFC 状态 -->
                <LinearLayout
                    android:id="@+id/rowNfc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NFC 状态"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/tvNfcState"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:text="检测中…"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 支持的卡种 -->
                <LinearLayout
                    android:id="@+id/rowSupported"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持的卡种与声明"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:text="中/韩/日/港"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 隐私说明 -->
                <LinearLayout
                    android:id="@+id/rowPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="隐私说明"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:text="只读 · 不联网 · 仅存本机"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>

                <!-- 清空全部 -->
                <LinearLayout
                    android:id="@+id/rowClear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/tile_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清空全部数据"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/up" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:text="删除所有卡片与记录"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="交通卡余额 v2.17 · 独立应用，与 T-money / Cashbee 等发卡机构无关联"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_sub"
                android:alpha="0.75"
                android:gravity="center"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav" />
</FrameLayout>
