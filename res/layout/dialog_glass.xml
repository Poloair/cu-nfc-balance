<?xml version="1.0" encoding="utf-8"?>
<!-- 统一玻璃弹窗：标题 + 可滚动正文 + 按钮行
     按钮用 TextView 而非 Button：系统 Button 自带 88dp 最小宽度 + 内嵌背景留白，
     在窄弹窗里即使 weight=1 也会被撑开，文字互相压住。TextView 没有这些默认约束。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/dlgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <ScrollView
        android:id="@+id/dlgMsgScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/dlgMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_sub" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/dlgBtnRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dlgBtnNeutral"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/brand_dark"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlgBtnNegative"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_sub"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dlgBtnPositive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="10dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
