<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:background="@drawable/header_bg">

        <TextView
            android:id="@+id/tvTripsTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/txn_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_main" />

        <Button
            android:id="@+id/btnTripsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/circle_bg"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <!-- 当次读取时间 / 数据来源说明 -->
    <TextView
        android:id="@+id/tvTripsSnap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:background="@drawable/chip_bg"
        android:textColor="@color/brand_dark"
        android:visibility="gone" />

    <!-- 本卡概览（新增）：余额 + 消费/充值笔数 -->
    <LinearLayout
        android:id="@+id/sumPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tile_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前余额"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub" />

                <TextView
                    android:id="@+id/tvSumBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ₩"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tile_bg"
                android:padding="12dp"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="消费笔数"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub" />

                <TextView
                    android:id="@+id/tvSumPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 笔"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tile_bg"
                android:padding="12dp"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充值笔数"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_sub" />

                <TextView
                    android:id="@+id/tvSumTopup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 笔"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/gain"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTripsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/txn_empty"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_sub"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvTrips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
