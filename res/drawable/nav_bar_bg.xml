<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮底栏：液态玻璃质感（半透明玻璃体 + 顶部高光 + 内侧反光描边） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 外缘柔和色调，让玻璃有厚度感 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#1F10A37F"
                android:endColor="#0A3E7BD6" />
        </shape>
    </item>

    <!-- 2. 玻璃主体：上亮下透的白色渐变（保留透光，让下层模糊可见） -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:startColor="#E0FFFFFF"
                android:centerColor="#C4F6FAF9"
                android:endColor="#AAFFFFFF" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
        </shape>
    </item>

    <!-- 3. 内侧反光：一圈更亮的细描边，模拟玻璃折射 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
